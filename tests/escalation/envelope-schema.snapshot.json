{
  "request": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "version": {
        "type": "number",
        "const": 2
      },
      "id": {
        "type": "string",
        "minLength": 1
      },
      "sessionId": {
        "type": "string",
        "minLength": 1
      },
      "parentSessionId": {
        "type": "string"
      },
      "pid": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "host": {
        "type": "string",
        "minLength": 1
      },
      "user": {
        "type": "string",
        "minLength": 1
      },
      "harness": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string"
          }
        },
        "required": ["name"],
        "additionalProperties": false
      },
      "toolName": {
        "type": "string"
      },
      "toolInput": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {}
      },
      "reason": {
        "type": "string"
      },
      "label": {
        "type": "string"
      },
      "annotations": {
        "type": "string"
      },
      "cwd": {
        "type": "string"
      },
      "transcriptPath": {
        "type": "string"
      },
      "git": {
        "type": "object",
        "properties": {
          "sha": {
            "type": "string",
            "minLength": 1
          },
          "branch": {
            "type": "string"
          },
          "dirty": {
            "type": "boolean"
          },
          "remote": {
            "type": "string"
          }
        },
        "required": ["sha"],
        "additionalProperties": false
      },
      "createdAt": {
        "type": "string"
      },
      "expiresAt": {
        "type": "string"
      }
    },
    "required": [
      "version",
      "id",
      "sessionId",
      "pid",
      "host",
      "user",
      "harness",
      "toolName",
      "toolInput",
      "reason",
      "cwd",
      "transcriptPath",
      "createdAt",
      "expiresAt"
    ],
    "additionalProperties": false
  },
  "response": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "decision": {
        "type": "string",
        "enum": ["allow", "deny", "harness-ask"]
      },
      "reason": {
        "type": "string"
      },
      "by": {
        "type": "string"
      },
      "decidedAt": {
        "type": "string"
      }
    },
    "required": ["id", "decision", "decidedAt"],
    "additionalProperties": false
  }
}
